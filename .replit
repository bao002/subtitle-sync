modules = ["web", "nodejs-20", "bash", "python-base-3.13", "java-graalvm22.3"]

[nix]
channel = "stable-25_05"
packages = ["at-spi2-atk", "atk", "cairo", "cups", "glib", "gtk3", "libdrm", "libgbm", "mesa", "nspr", "nss", "pango", "xorg.libX11", "xorg.libXcomposite", "xorg.libXdamage", "xorg.libXext", "xorg.libXfixes", "xorg.libXrandr", "xorg.libxcb", "libxkbcommon", "alsa-lib"]

[agent]
expertMode = true

[[ports]]
localPort = 3000
externalPort = 80
